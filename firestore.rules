rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 通用函數 ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth.token.admin == true;
    }

    function getAppId() {
      return request.path[4];
    }

    function getTodayStartTime() {
      // 計算今天 00:00:00 的毫秒時間戳
      let now_ms = request.time.toMillis();
      return int(now_ms - (now_ms % 86400000));
    }

    // --- 員工資料集合 ---
    match /artifacts/{appId}/public/data/employees/{empId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && isAdmin();
    }

    // --- 打卡紀錄集合（含重複偵測） ---
    match /artifacts/{appId}/public/data/attendance/{docId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && 
        validatePunchRecord() &&
        !isDuplicatePunch() &&
        isEmployeeValid();
      
      allow update, delete: if isAuthenticated() && isAdmin();
    }

    // --- 打卡紀錄驗證規則 ---
    function validatePunchRecord() {
      let req = request.resource.data;
      
      return req.size() >= 8 &&
        // 必填欄位
        req.employeeId is string &&
        req.employeeName is string &&
        req.employeeTitle is string &&
        req.timestamp is number &&
        req.dateStr is string &&
        req.timeStr is string &&
        req.punchType is string &&
        req.remark is string &&
        
        // 打卡類型驗證
        req.punchType in ['上班', '休息開始', '休息結束', '下班'] &&
        
        // 時間戳驗證（不能是未來時間，且不超過 1 分鐘）
        req.timestamp <= request.time.toMillis() &&
        (request.time.toMillis() - req.timestamp) < 60000 &&
        
        // 員工ID驗證
        req.employeeId.size() > 0;
    }

    // --- 員工狀態驗證 ---
    function isEmployeeValid() {
      let empId = request.resource.data.employeeId;
      let appId = getAppId();
      
      let empRef = /databases/$(database)/documents/artifacts/$(appId)/public/data/employees/$(empId);
      
      return exists(empRef) && 
        get(empRef).data.status != '離職';
    }

    // --- 重複打卡偵測邏輯 ---
    function isDuplicatePunch() {
      let req = request.resource.data;
      let appId = getAppId();
      
      // 取得該員工今日最新的打卡紀錄
      // 由於 Firestore Rules 的查詢限制，我們在這裡只做基本驗證
      // 詳細的重複偵測邏輯應由 Cloud Functions 處理
      
      // 注意：完整的集合查詢在 Firestore Rules 中不可用
      // 此函數為預留位置，實際邏輯應在 Cloud Functions onWrite 觸發器中實現
      return false;
    }

    // --- 審計日誌集合（記錄被拒絕的打卡嘗試） ---
    match /artifacts/{appId}/public/data/audit_logs/{logId} {
      allow read: if isAuthenticated() && isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // --- 通知集合（管理員異常打卡提醒） ---
    match /artifacts/{appId}/public/data/notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated();
      allow update: if false;
    }

    // --- 請假紀錄集合 ---
    match /artifacts/{appId}/public/data/leave_records/{leaveId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && 
        validateLeaveRecord();
      
      allow update, delete: if isAuthenticated() && isAdmin();
    }

    // --- 請假紀錄驗證規則 ---
    function validateLeaveRecord() {
      let req = request.resource.data;
      
      return req.size() >= 8 &&
        req.employeeId is string &&
        req.employeeName is string &&
        req.employeeTitle is string &&
        req.type is string &&
        req.startDate is string &&
        req.endDate is string &&
        req.startTime is string &&
        req.endTime is string &&
        
        req.type in ['事假', '病假', '公假', '特休假', '婚假', '喪假', '其他假別'] &&
        req.startDate <= req.endDate &&
        req.employeeId.size() > 0;
    }
  }
}
